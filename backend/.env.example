# Backend environment
# Copy to .env for local development. On Render, set these in the dashboard
# Environment section instead of committing a .env file.
#
# Render build command: npm install --omit=dev
# The only devDependency is mongodb-memory-server, used by `npm test`. Its
# postinstall downloads a mongod binary, which is wasted weight on a deploy
# and can stall or fail the build.

# Port Render injects automatically; keep the default for local runs.
PORT=5000

# MongoDB Atlas connection string.
# MONGODB_URI is read for backwards compatibility; MONGO_URI wins if both set.
MONGO_URI=

# Sign access tokens with a long random value. The server refuses to boot in
# production without it.
JWT_SECRET=replace_with_a_long_random_secret

JWT_EXPIRES_IN=7d

# Public URL of the deployed frontend. Comma-separate multiple origins
# (e.g. production plus Vercel previews). Unset = CORS allows any origin.
CLIENT_URL=http://localhost:5173

# Groq key for the AI assistant. Missing key disables AI, not the app.
GROQ_API_KEY=
GROQ_MODEL=

NODE_ENV=development
