# Frontend environment
# Vite only exposes variables prefixed with VITE_.
# Never put API keys, database URIs or JWT secrets in here - this file is
# bundled into the public site.

# Local development: point at the Express server on this machine.
VITE_API_BASE_URL=http://localhost:5000/api

# Vercel (set in Project Settings -> Environment Variables, no trailing slash):
# VITE_API_BASE_URL=https://campus-clubs-events-management.onrender.com/api
